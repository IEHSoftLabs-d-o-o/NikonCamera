<Window x:Class="NikonCamera.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Width="400"
        SizeToContent="Height"
        Title="Einstellungen"
        Loaded="SettingsWindow_OnLoaded">

    <Window.Resources>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <GroupBox Header=""
                  Margin="10">
            <StackPanel Margin="5">
                <TextBlock Text="Kameramodell"></TextBlock>
                <ComboBox Name="ComboBoxCameraModels"
                          Width="150"
                          Height="20"
                          Margin="0,4,0,8"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Manufacturer}"></TextBlock>
                                <TextBlock Margin="5,0,0,0" Text="{Binding Model}"></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Foto-Ordner"></TextBlock>
                <DockPanel Margin="0,4,0,8">
                    <Button Name="ButtonBrowseFotoFolder"
                            DockPanel.Dock="Right"
                            Content="..."
                            Width="28"
                            Margin="4,0,0,0"
                            Click="ButtonBrowseFotoFolder_OnClick">
                    </Button>
                    <TextBox Name="TextBoxFotoFolder"
                             IsReadOnly="True"></TextBox>
                </DockPanel>
                <TextBlock Text="ArianaLab-Adresse"></TextBlock>
                <TextBox Name="TextBoxBaseUrl"
                         Margin="0,4,0,8"></TextBox>
                <TextBlock Text="Anmeldung"></TextBlock>
                <TextBox Name="TextBoxAuth"
                         Margin="0,4,0,8"></TextBox>
                <TextBlock Text="ArianaLab Client"></TextBlock>
                <DockPanel Margin="0,4,0,0">
                    <Button Name="ButtonBrowseArianaLabClient"
                            DockPanel.Dock="Right"
                            Content="..."
                            Width="28"
                            Margin="4,0,0,0"
                            Click="ButtonBrowseArianaLabClient_OnClick">
                    </Button>
                    <TextBox Name="TextBoxArianaLabClient"
                             IsReadOnly="True"></TextBox>
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Name="ButtonOk"
                    Width="100"
                    Height="25"
                    Margin="5"
                    Content="OK"
                    Click="ButtonOk_OnClick">
            </Button>
            <Button Name="ButtonCancel"
                    Width="100"
                    Height="25"
                    Margin="5"
                    Content="Abbrechen"
                    Click="ButtonCancel_OnClick">
            </Button>
        </StackPanel>
    </Grid>
</Window>
