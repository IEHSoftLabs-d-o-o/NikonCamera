<Window x:Class="NikonCamera.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xamlBehaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:NikonCamera.Tools.Behaviors"
        xmlns:converters="clr-namespace:NikonCamera.Tools.Converters"
        mc:Ignorable="d"      
        Title="{Binding AppTitle}"
        Height="800" 
        Width="1000"
        Topmost="False"
        UseLayoutRounding="True"        
        ResizeMode="CanResizeWithGrip"
        Closing="MainWindow_OnClosing"
        PreviewTextInput="MainWindow_OnPreviewTextInput"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown">

    <xamlBehaviors:Interaction.Triggers>
        <xamlBehaviors:EventTrigger EventName="Closing">
            <xamlBehaviors:InvokeCommandAction Command="{Binding ClosingCommand}"></xamlBehaviors:InvokeCommandAction>
        </xamlBehaviors:EventTrigger>
    </xamlBehaviors:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock" x:Key="TextBlockStatus">
                <Setter Property="Margin" Value="10"></Setter>
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="Foreground" Value="#2A3E91"></Setter>
            </Style>
            <Style TargetType="TextBlock" x:Key="TextBlockInfo">
                <Setter Property="Margin" Value="5"></Setter>
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="FontSize" Value="20"></Setter>
                <Setter Property="FontWeight" Value="Normal"></Setter>
                <Setter Property="Foreground" Value="White"></Setter>
            </Style>
            <Style TargetType="TextBlock" x:Key="TextBlockAngle" BasedOn="{StaticResource TextBlockInfo}">
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="Foreground" Value="#2A3E91"></Setter>
            </Style>
            <Style TargetType="TextBlock" x:Key="TextBlockPicture">
                <Setter Property="Margin" Value="20,10,10,10"></Setter>
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="Foreground" Value="#2A3E91"></Setter>
            </Style>
            <Style TargetType="TextBox" x:Key="TextBoxSearch">
                <Setter Property="Margin" Value="5"></Setter>
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="FontWeight" Value="Normal"></Setter>
                <Setter Property="Foreground" Value="White"></Setter>
            </Style>
            <Style TargetType="DataGridColumnHeader" x:Key="DataGridColumnHeaderHeaderStyle">
                <Setter Property="Background" Value="#0072C6"></Setter>
                <Setter Property="Foreground" Value="White"></Setter>
                <Setter Property="Height" Value="Auto"></Setter>
                <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
            </Style>
            <Style TargetType="TextBlock" x:Key="TextBlockTableCell">
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="FontSize" Value="12"></Setter>
                <Setter Property="VerticalAlignment" Value="Center"></Setter>
                <Setter Property="Margin" Value="5"></Setter>
            </Style>
            <converters:MultiValueConverter x:Key="MultiValueConverter"></converters:MultiValueConverter>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"></BooleanToVisibilityConverter>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#2A3E91">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource TextBoxSearch}"
                         Width="130"
                         Foreground="Black"
                         Text="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Command="{Binding LoadSamplesCommand}" Key="Enter"></KeyBinding>
                        <KeyBinding Command="{Binding LoadSamplesCommand}" Key="Return"></KeyBinding>
                    </TextBox.InputBindings>
                </TextBox>
                <Border Margin="20,0,0,0"></Border>
                <Button Name="ButtonSettings"
                        Command="{Binding SettingsCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <Image Source="/Images/settings.png"
                                       Height="20"></Image>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Style="{StaticResource TextBlockInfo}"
                           Text="{Binding CameraInfo,FallbackValue=NIKON D90}"></TextBlock>
                <TextBlock Style="{StaticResource TextBlockInfo}"
                           Text="-"></TextBlock>
                <TextBlock Style="{StaticResource TextBlockInfo}"
                           Text="{Binding SampleInfo,FallbackValue=B26-101637 - Döner mit alles}"></TextBlock>
                <Button Width="75" 
                        Height="25" 
                        Content="Barcode"
                        Command="{Binding SimulateBarcodeCommand}"
                        Visibility="Collapsed"></Button>
            </StackPanel>
        </Border>
        <Border Grid.Row="1"
                ClipToBounds="True">
            <Grid ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <DataGrid ItemsSource="{Binding Samples}"
                          SelectedItem="{Binding SelectedSample,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderHeaderStyle}"
                          AlternatingRowBackground="LightYellow"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          CanUserDeleteRows="False"
                          IsReadOnly="false"                                                 
                          AutoGenerateColumns="False"
                          FrozenColumnCount="0"
                          EnableRowVirtualization="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightSkyBlue"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="LightSkyBlue"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="LightSkyBlue"/>
                            </Style.Resources>
                        </Style>
                    </DataGrid.RowStyle>
                    <xamlBehaviors:Interaction.Behaviors>
                        <behaviors:DataGridScrollIntoViewBehavior></behaviors:DataGridScrollIntoViewBehavior>
                    </xamlBehaviors:Interaction.Behaviors>
                    <xamlBehaviors:Interaction.Triggers>
                        <xamlBehaviors:EventTrigger EventName="SelectionChanged">
                            <xamlBehaviors:InvokeCommandAction Command="{Binding SelectedSampleChangedCommand}"></xamlBehaviors:InvokeCommandAction>
                        </xamlBehaviors:EventTrigger>
                    </xamlBehaviors:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn MinWidth="100">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlockTableCell}" 
                                               Text="Probennummer"></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource TextBlockTableCell}" 
                                               Text="{Binding Number}"></TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Column="1">
                    <Image Name="MyImage"
                           Margin="5" 
                           Source="{Binding PreviewCameraImage}"
                           Stretch="Uniform">
                    </Image>
                    <Grid Width="{Binding ElementName=MyImage,Path=ActualWidth}"
                          Height="{Binding ElementName=MyImage,Path=ActualHeight}">
                        <Image Name="LiveViewIndicatorImage"
                               Source="/Images/live.png" 
                               Height="25"
                               Margin="10"
                               Visibility="{Binding LiveViewVisibility}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Right">
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard>
                                            <Storyboard Duration="00:00:02" 
                                                        RepeatBehavior="Forever" 
                                                        AutoReverse="True">
                                                <DoubleAnimation From="0"
                                                                 To="1" 
                                                                 Storyboard.TargetName="LiveViewIndicatorImage" 
                                                                 Storyboard.TargetProperty="Opacity"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" 
                   Style="{StaticResource TextBlockStatus}" 
                   Text="{Binding StatusMessage, FallbackValue=PIC1.jpg}"
                   HorizontalAlignment="Center">
        </TextBlock>
        <ListView Grid.Row="3"
                  ItemsSource="{Binding CameraImages}"
                  SelectedItem="{Binding SelectedCameraImage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <xamlBehaviors:Interaction.Behaviors>
                <behaviors:ListBoxScrollIntoViewBehavior></behaviors:ListBoxScrollIntoViewBehavior>
            </xamlBehaviors:Interaction.Behaviors>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"></StackPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <xamlBehaviors:Interaction.Triggers>
                            <xamlBehaviors:EventTrigger EventName="MouseUp">
                                <xamlBehaviors:InvokeCommandAction Command="{Binding DataContext.ImageMouseDownCommand,ElementName=LayoutRoot}"></xamlBehaviors:InvokeCommandAction>
                            </xamlBehaviors:EventTrigger>
                        </xamlBehaviors:Interaction.Triggers>
                        <Image Height="150" Source="{Binding ImageSource}"></Image>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal">
                            <CheckBox Name="CheckBoxImage" 
                                      Margin="0,10,-10,0"
                                      IsHitTestVisible="False"
                                      IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                            </CheckBox>
                            <TextBlock Style="{StaticResource TextBlockPicture}"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Name}">
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Bild löschen"
                              Command="{Binding DeletePictureCommand}">
                    </MenuItem>
                    <MenuItem Header="Bild hinzufügen" 
                              Command="{Binding AddPictureCommand}"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
        <ProgressBar Grid.Row="4"
                     Height="30"
                     Margin="10"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}"></ProgressBar>
        <StackPanel Grid.Row="5" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button Name="ButtonToggleLiveView" Margin="5" Width="150" Height="25" Content="{Binding ToggleButtonContent,FallbackValue=Toggle Live View}" Command="{Binding ToggleLiveViewCommand}"></Button>
                <Button Name="ButtonCapture" Margin="5" Width="75" Height="25" Content="Capture" Command="{Binding CaptureCommand}"></Button>
                <Button Margin="5" Width="125" Height="25" Content="Bild hinzufügen" Command="{Binding AddPictureCommand}"></Button>
                <Button Name="ButtonRotateClockwise" 
                        Width="20" 
                        Height="20" 
                        Margin="10"                    
                        Command="{Binding RotateCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Image Source="/Images/circular-clockwise-arrow.png"></Image>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Style="{StaticResource TextBlockAngle}" Margin="0,10,0,10"  Text="{Binding Angle,FallbackValue=90}"></TextBlock>
                <TextBlock Style="{StaticResource TextBlockAngle}" Margin="0,10,5,10" Text="°"></TextBlock>
                <Image Margin="5" Source="/Images/live.png" Height="25" Visibility="{Binding LiveViewVisibility}"></Image>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

